# Пример переменных для leads-api. Настоящие значения — в .env (он в git не попадает).
# Скопируйте: cp .env.example .env  и заполните.

# Токен бота, который доставляет заявки (получается у @BotFather в Telegram)
BOT_TOKEN=

# Куда доставлять: id чата (группа «агенты совещание» — отрицательный) и номер темы форума
CHAT_ID=-1003901177054
THREAD_ID=16

# Порт внутри контейнера. Менять не нужно, если не занят на хосте
PORT=8099

# Адрес прослушивания. В контейнере обязательно 0.0.0.0, иначе проброс порта не работает.
# Запуск без Docker (systemd) — 127.0.0.1, наружу через Caddy.
HOST=0.0.0.0

# Куда складывать журнал запросов (внутри контейнера — папка /app/logs)
LOG_DIR=/app/logs

# Адрес Bot API. По умолчанию https://api.telegram.org; если прямой недоступен —
# зеркало (у нас используется https://agi.mcdenil.com/tgproxy)
TG_API_ROOT=https://api.telegram.org

# Ваш личный Telegram id: сюда придёт заявка, если доставка в тему не удалась
OWNER_ID=
